{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-ops.local/schemas/profile.schema.json",
  "title": "HomeOps evaluation profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "stale_after_days", "hard_filters", "weighted_criteria", "recommendation"],
  "properties": {
    "schema_version": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "stale_after_days": { "type": "integer", "minimum": 0 },
    "hard_filters": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "#/$defs/criterion" },
          { "not": { "type": "object", "properties": { "weight": {} }, "required": ["weight"] } }
        ]
      }
    },
    "weighted_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/criterion" },
          {
            "type": "object",
            "required": ["weight"],
            "properties": { "weight": { "type": "number", "exclusiveMinimum": 0 } }
          }
        ]
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visit_score", "prioritize_score"],
      "properties": {
        "discard_below_score": { "type": "number", "minimum": 0, "maximum": 100 },
        "visit_score": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "prioritize_score": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 }
      }
    }
  },
  "$defs": {
    "field": {
      "enum": [
        "property.operation",
        "property.property_type",
        "property.location.country_code",
        "property.location.admin_area",
        "property.location.city",
        "property.location.neighborhood",
        "property.pricing.price",
        "property.pricing.currency",
        "property.pricing.expenses",
        "property.pricing.expenses_currency",
        "property.features.bedrooms",
        "property.features.bathrooms",
        "property.features.area_total_m2",
        "property.features.area_covered_m2",
        "property.features.parking_spaces",
        "freshness.state"
      ]
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "field", "operator", "value"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "label": { "type": "string", "minLength": 1 },
        "field": { "$ref": "#/$defs/field" },
        "operator": { "enum": ["equals", "one_of", "at_least", "at_most"] },
        "value": {
          "oneOf": [
            { "type": "string" },
            { "type": "number" },
            { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
          ]
        },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "allow_inferred": { "type": "boolean", "default": false },
        "weight": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
