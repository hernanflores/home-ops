{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-ops.local/schemas/financing-result.schema.json",
  "title": "HomeOps financing result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "currency", "method", "disclaimer", "scenarios"],
  "properties": {
    "schema_version": { "const": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "method": { "type": "string", "minLength": 1 },
    "disclaimer": { "type": "string", "minLength": 1 },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "scenarios": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/result" } }
  },
  "$defs": {
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency", "unit"],
      "properties": {
        "amount": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "unit": { "enum": ["one_time", "monthly", "total"] }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "inputs", "down_payment", "loan_principal", "monthly_installment", "total_installments", "total_interest", "recurring_costs", "monthly_housing_cost", "total_recurring_cost", "total_cash_outlay", "formula_assumptions"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "inputs": { "type": "object" },
        "down_payment": { "$ref": "#/$defs/money" },
        "loan_principal": { "$ref": "#/$defs/money" },
        "monthly_installment": { "$ref": "#/$defs/money" },
        "total_installments": { "$ref": "#/$defs/money" },
        "total_interest": { "$ref": "#/$defs/money" },
        "recurring_costs": { "type": "array", "items": { "type": "object" } },
        "monthly_housing_cost": { "$ref": "#/$defs/money" },
        "total_recurring_cost": { "$ref": "#/$defs/money" },
        "total_cash_outlay": { "$ref": "#/$defs/money" },
        "currency_exposure": { "type": ["object", "null"] },
        "formula_assumptions": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
